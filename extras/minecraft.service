# WorldBackUp - 리눅스(systemd)용 서버 유닛
#
# /wb confirm 이후 서버는 스스로 꺼집니다. 누군가 다시 켜야 복원이 적용되므로
# Restart=always 로 두어 다음 부팅에서 복원이 적용되게 합니다.
#
# 설치:
#   sudo cp extras/minecraft.service /etc/systemd/system/minecraft.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now minecraft
#
# Restart=always 라 /stop 으로도 다시 켜집니다. 정말 끌 때는 systemctl stop minecraft 를 쓰세요.
#
# 참고: 복원이 실패해도 systemd 는 그대로 다시 켭니다. 플러그인이 restore-failed-*.yml 을 남기고
# 자동 백업·보관 정리를 스스로 멈추므로 멀쩡한 예전 백업이 밀려나지는 않지만, 반쯤 복원된 월드로
# 서버가 계속 돌아가는 것은 막지 못합니다. 그것까지 막으려면 ExecStartPre 로 표식을 확인하세요.

[Unit]
Description=Minecraft Paper
After=network.target
StartLimitIntervalSec=300
# 5분에 5회 넘게 죽으면 중단한다 (크래시 루프 방지)
StartLimitBurst=5

[Service]
Type=simple
User=minecraft
WorkingDirectory=/srv/minecraft
ExecStart=/usr/bin/java -Xms4G -Xmx4G -jar paper-26.2.jar nogui
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
