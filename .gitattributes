# 저장소에는 항상 LF 로 저장한다. 작업 복사본의 줄바꿈은 OS 에 맞게 맡긴다.
* text=auto

# 셸 스크립트는 작업 복사본에서도 반드시 LF 여야 한다.
# CRLF 가 섞이면 Git Bash / 리눅스에서 gradlew 가 "bad interpreter" 로 죽는다.
gradlew  text eol=lf
*.sh     text eol=lf

# 윈도우 배치 파일은 반대로 CRLF 를 유지한다.
gradlew.bat text eol=crlf
*.bat       text eol=crlf

# 줄바꿈 변환이 닿으면 안 되는 파일들.
*.jar binary
*.zip binary
*.mca binary
*.dat binary
